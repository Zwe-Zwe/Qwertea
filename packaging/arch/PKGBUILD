# Maintainer: Zwe-Zwe <https://github.com/Zwe-Zwe>

pkgname=qwertea
pkgver=1.0.1
pkgrel=1
pkgdesc="Adaptive typing tutor that builds every lesson from your own weak keys and letter patterns"
arch=('x86_64' 'aarch64')
url="https://github.com/Zwe-Zwe/Qwertea"
license=('MIT')
depends=(
  'gcc-libs' 'glibc'
  'libxkbcommon' 'libxkbcommon-x11'
  'vulkan-icd-loader'
  'hicolor-icon-theme'
  'python' 'python-numpy' 'python-scipy' 'python-matplotlib' 'python-typer'
)
makedepends=('cargo' 'python-build' 'python-installer' 'python-hatchling' 'python-wheel')
optdepends=(
  'python-lightgbm: explainable insight model in the HTML report (AUR)'
  'vulkan-driver: GPU rendering (e.g. vulkan-radeon, vulkan-intel, nvidia-utils)'
  'mesa: OpenGL fallback renderer'
  'wayland: native Wayland window'
  'xdg-utils: open the HTML report in your browser'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() { echo "$srcdir/Qwertea-$pkgver"; }

prepare() {
  cd "$(_srcdir)/client"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcdir)/client"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release --features evdev-capture --bin qwertea

  cd "$(_srcdir)/engine"
  python -m build --wheel --no-isolation
}

check() {
  cd "$(_srcdir)/client"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --lib
}

package() {
  cd "$(_srcdir)"
  install -Dm755 client/target/release/qwertea "$pkgdir/usr/bin/qwertea"
  python -m installer --destdir="$pkgdir" engine/dist/*.whl
  install -Dm644 packaging/qwertea.desktop "$pkgdir/usr/share/applications/qwertea.desktop"
  install -Dm644 packaging/qwertea.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/qwertea.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 client/assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-AtkinsonHyperlegible.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
